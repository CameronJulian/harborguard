# HarborGuard environment contract
#
# Never commit real credentials or production secret values.
# Copy this file to .env.local for local development.
# Configure production secrets in the deployment platform.
#
# Runtime/platform-managed variables such as CI, NEXT_RUNTIME,
# NODE_ENV, and VERCEL_ENV are intentionally not assigned here.

# ============================================================
# Core application
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Supabase
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# SERVER ONLY
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Cron / scheduled jobs
# ============================================================

CRON_SECRET=

# ============================================================
# Push notifications
# ============================================================

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================================
# Email
# ============================================================

RESEND_API_KEY=
RESEND_FROM_EMAIL=
ALERT_EMAIL=
FLEET_ALERT_EMAIL=

# ============================================================
# Twilio
# ============================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_SMS_TO=
TWILIO_WHATSAPP_FROM=

# ============================================================
# PayFast
# ============================================================

PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_PROFESSIONAL_AMOUNT=
PAYFAST_SANDBOX=false

# ============================================================
# Redis
# ============================================================

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Mapping / routing
# ============================================================

GOOGLE_ROUTES_API_KEY=
HERE_API_KEY=
ORS_API_KEY=
TOMTOM_API_KEY=
AZURE_MAPS_TRAFFIC_BBOX=
TOMTOM_TRAFFIC_BBOX=

# ============================================================
# Route-risk controls
# ============================================================

ENABLE_ROUTE_RISK_SHADOW_ALTERNATIVE_ROUTES=false
ENABLE_ROUTE_CORRIDOR_TRAFFIC_DIAGNOSTICS=false
ROUTE_RISK_SHADOW_ALLOWED_ORGANIZATION_IDS=
ROUTE_RISK_SHADOW_CAPACITY_LEASE_SECONDS=
ROUTE_RISK_SHADOW_CAPACITY_WINDOW_SECONDS=
ROUTE_RISK_SHADOW_GLOBAL_CALL_LIMIT=
ROUTE_RISK_SHADOW_GLOBAL_CONCURRENCY_LIMIT=
ROUTE_RISK_SHADOW_ORGANIZATION_CALL_LIMIT=
ROUTE_RISK_SHADOW_ORGANIZATION_CONCURRENCY_LIMIT=
ROUTE_RISK_SHADOW_PROVIDER_TIMEOUT_MS=
ROUTE_RISK_SHADOW_SAMPLING_PERCENTAGE=

# ============================================================
# Traffic / road context
# ============================================================

CITY_OF_CAPE_TOWN_PEDESTRIAN_CROSSING_URL=
TRAFFIC_CENTER_LATITUDE=
TRAFFIC_CENTER_LONGITUDE=
TRAFFIC_IMPORT_ORGANIZATION_ID=
TRAFFIC_IMPORT_RADIUS_METERS=

# ============================================================
# Traccar
# ============================================================

TRACCAR_API_BASE_URL=
TRACCAR_API_TOKEN=

# ============================================================
# Samsara
# ============================================================

SAMSARA_API_BASE_URL=
SAMSARA_API_TOKEN=

# ============================================================
# Vision / AI
# ============================================================

VISION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=
